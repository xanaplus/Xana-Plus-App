   }
  },
  {
   "text": "Pharmacist · PPB Reg. No. 12345",
   "style": "Inter 400 13px ls=0",
   "box": {
    "x": 108,
    "y": 112
   }
  },
  {
   "text": "Online now",
   "style": "Inter 600 12px ls=0",
   "box": {
    "x": 120,
    "y": 132
   }
  },
  {
   "text": "Usually replies in under 3 minutes",
   "style": "Inter 400 13px ls=0",
   "box": {
    "x": 59,
    "y": 162
   }
  },
  {
   "text": "This conversation is private. It is not shared\nwith your household, and it does not appear in\nyour order history.",
   "style": "Inter 400 13px ls=0",
   "box": {
    "x": 57,
    "y": 241
   }
  },
  {
   "text": "What would you like to ask about?",
