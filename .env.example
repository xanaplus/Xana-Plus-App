# Figma REST API - used by scripts/sync-design.mjs
#
# Create a token at: Figma -> Settings -> Security -> Personal access tokens
# Scope required: "File content: read"
#
# Preferred: point at a file holding the token, so the secret never lands in
# this repo at all.
FIGMA_TOKEN_FILE=C:\Users\you\path\to\figmatkn.txt
#
# Alternative: put the token inline instead (this file's real copy, .env, is gitignored).
# FIGMA_TOKEN=figd_paste_your_token_here

# The XanaPlusApp design file. Override only if you point the sync at another file.
FIGMA_FILE_KEY=G4iVN6s7cWFkkl2oCXuhb8

# Supabase - the app's backend (accounts, sign-in codes).
# Both values are public: Project Settings -> API Keys -> "Publishable key".
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_paste_here
#
# Server secrets (Africa's Talking key, OTP pepper, demo number) are NOT set here.
# They live in Supabase: npx supabase secrets set NAME=value
